#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/mobile/build/
/mobile/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/mobile/android/app/debug
/mobile/android/app/profile
/mobile/android/app/release

# LearnMate backend
backend/.env
backend/.venv/
backend/*.db
backend/media/
backend/__pycache__/
backend/app/__pycache__/
backend/tests/__pycache__/
*.db
.venv/
.pytest_cache/

# Android release signing
mobile/android/key.properties
mobile/android/app/*.jks
mobile/android/app/*.keystore

# Postman desktop local workspace metadata (exported collections stay tracked)
/.postman/
/postman/globals/
/postman/flows/
/postman/mocks/
