    {
      "name": "Classrooms",
      "item": [
        {
          "name": "Đăng nhập giáo viên",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{teacherEmail}}\",\n  \"password\": \"{{teacherPassword}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Teacher login succeeds', function () { pm.response.to.have.status(200); });",
                  "['teacherToken', 'classId', 'joinCode', 'membershipId', 'assignmentId', 'analysisId'].forEach(function (key) { pm.environment.unset(key); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.user.role).to.eql('teacher');",
                  "if (body.access_token) pm.environment.set('teacherToken', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Tạo lớp",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{teacherToken}}", "type": "string" }]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"English Communication B1\",\n  \"description\": \"Lớp luyện giao tiếp và viết\",\n  \"target_level\": \"B1\"\n}",
