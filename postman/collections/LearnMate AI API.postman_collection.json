{
  "info": {
    "_postman_id": "a992e7e0-6e6c-4ba8-a21f-07a8892f7001",
    "name": "LearnMate AI API",
    "description": "Safe local workspace for learner, learning-path and administration APIs. Login requests save JWTs only to the selected local Postman environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "Readiness",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health/ready",
            "description": "Confirms that the API and database are ready."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API is ready', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().status).to.eql('ready');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "OpenAPI document",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/openapi.json"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Đăng ký học viên",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"{{learnerPassword}}\",\n  \"display_name\": \"{{learnerDisplayName}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/register"
          }
        },
        {
          "name": "Đăng nhập học viên",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{learnerEmail}}\",\n  \"password\": \"{{learnerPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Learner login succeeds', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.access_token) pm.environment.set('accessToken', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Hồ sơ hiện tại",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/auth/me"
          }
        }
      ]
    },
    {
      "name": "Analyses",
      "item": [
        {
          "name": "Phân tích đọc hiểu",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_text\": \"Learning a language takes regular practice and useful feedback.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/analysis-jobs/reading"
          }
        },
        {
          "name": "Chấm bài viết",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_text\": \"I want improve my English because it help me communicate at work.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/analysis-jobs/writing"
          }
        },
        {
          "name": "Chấm nội dung transcript",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"input_text\": \"I usually practice English by speaking with my classmates after school.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/analysis-jobs/speaking",
            "description": "Evaluates transcript relevance, grammar and vocabulary; it does not claim to grade pronunciation."
          }
        },
        {
          "name": "Lịch sử phân tích",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/analyses?limit=20&offset=0"
          }
        }
      ]
    },
    {
      "name": "Learning Paths",
      "item": [
        {
          "name": "Tạo lộ trình 7 ngày",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"goal\": \"Giao tiếp tự tin trong công việc\",\n  \"current_level\": \"B1\",\n  \"minutes_per_day\": 30\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/learning-path-jobs"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Learning path job was queued', function () {",
                  "  pm.response.to.have.status(202);",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.operation).to.equal('generate');",
                  "  pm.environment.set('learningPathJobId', body.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Lộ trình hiện tại",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/learning-paths/current"
          }
        },
        {
          "name": "Lịch sử lộ trình",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/learning-paths?limit=20&offset=0"
          }
        }
      ]
    },
    {
      "name": "Administration",
      "item": [
        {
          "name": "Đăng nhập quản trị",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Admin login succeeds', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.expect(body.user.role).to.eql('admin');",
                  "if (body.access_token) pm.environment.set('adminToken', body.access_token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Thống kê quản trị",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/stats"
          }
        },
        {
          "name": "Danh sách người dùng",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/users?limit=20&offset=0"
          }
        },
        {
          "name": "Danh sách bài phân tích",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/analyses?limit=20&offset=0"
          }
        },
        {
          "name": "Danh sách lộ trình",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/learning-paths?limit=20&offset=0"
          }
        },
        {
          "name": "Nhật ký quản trị",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/admin/audit-logs?limit=50"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ]
}
