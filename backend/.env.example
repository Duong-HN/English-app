APP_NAME=LearnMate AI API
APP_VERSION=0.7.0
APP_ENV=development
DATABASE_URL=sqlite:///./learnmate.db
AUTO_CREATE_SCHEMA=true

# Generate a strong random secret before deployment.
JWT_SECRET=development-only-change-me
ACCESS_TOKEN_MINUTES=1440
REFRESH_TOKEN_DAYS=30
ENABLE_DEV_AUTH=true
MFA_ENCRYPTION_KEY=

AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45

# Lesson audio/video files are kept outside the database. Mount this directory
# to persistent object storage in production and set a public API base URL if
# the API is behind a different gateway hostname.
MEDIA_STORAGE_DIR=./media
MEDIA_STORAGE_BACKEND=local
MEDIA_MAX_SIZE_MB=100
MEDIA_PUBLIC_BASE_URL=
MEDIA_CDN_BASE_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ENDPOINT_URL=

# Local default is in-process. Production must use the Redis backend and a private Redis URL.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_BACKEND=memory
REDIS_URL=

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
