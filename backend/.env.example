APP_NAME=LearnMate AI API
APP_VERSION=0.7.0
APP_ENV=development
DATABASE_URL=sqlite:///./learnmate.db
AUTO_CREATE_SCHEMA=true

# Generate a strong random secret before deployment.
JWT_SECRET=development-only-change-me
ACCESS_TOKEN_MINUTES=1440
ENABLE_DEV_AUTH=true

AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=45

ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
